DOCUMENT_PROCESSOR_URL=http://127.0.0.1:8765

# Vercel shared pilot (set automatically when you add Storage integrations on Vercel).
# Local dev uses data/ on disk when these are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional future hosted database (not used by the current pilot UI).
# Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
